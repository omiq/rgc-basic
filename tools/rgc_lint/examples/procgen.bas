10 CLS
20 DIM M(15,7)
30 FOR Y = 0 TO 7
40 FOR X = 0 TO 15
50 M(X,Y) = 0
60 IF X = 0 THEN M(X,Y) = 1
70 IF X = 15 THEN M(X,Y) = 1
80 IF Y = 0 THEN M(X,Y) = 1
90 IF Y = 7 THEN M(X,Y) = 1
100 IF INT(RND(1)*5) = 0 THEN M(X,Y) = 1
110 NEXT X
120 NEXT Y
130 FOR Y = 0 TO 7
140 FOR X = 0 TO 15
150 IF M(X,Y) = 1 THEN TEXTAT X,Y,"#"
160 IF M(X,Y) = 0 THEN TEXTAT X,Y,"."
170 NEXT X
180 NEXT Y
