REM ** GALAXY MAP ROMAN NUMERALS **
FUNCTION RomanNumeral()

    PRINT "";
    SELECT CASE J
    CASE 1, 5
        PRINT " I ";;
    CASE 2, 6
        PRINT "II ";
    CASE 3, 7
        PRINT "III";
    CASE 4, 8
        PRINT "IV ";
    END SELECT
    PRINT " "; : RETURN
END FUNCTION

