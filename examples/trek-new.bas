    H8=0
    G5=1
    A=5
    A1=5
    PRINT : PRINT "{CLR}{REVERSE ON}THE GALAXY:{REVERSE OFF}" : PRINT : PRINT "   ";
    RETURN ComputerGalacticRecord()
END FUNCTION


