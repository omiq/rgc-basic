QuadrantSuffix: IF G5=1 THEN RETURN
IF Z5=1 THEN GOTO Suffix1
IF Z5=2 THEN GOTO Suffix2
IF Z5=3 THEN GOTO Suffix3
IF Z5=4 THEN GOTO Suffix4
IF Z5=5 THEN GOTO Suffix1
IF Z5=6 THEN GOTO Suffix2
IF Z5=7 THEN GOTO Suffix3
IF Z5=8 THEN GOTO Suffix4
RETURN
Suffix1: G2$=G2$+" I" : RETURN
Suffix2: G2$=G2$+" II" : RETURN
Suffix3: G2$=G2$+" III" : RETURN
Suffix4: G2$=G2$+" IV" : RETURN
GetInput: REM ** LX = MAX INPUT  LII$ = OUTPUT STRING **
REM PRINT "> ";
LII$=""
GetInputLoop: GET Y$
Y$=UCASE$(Y$)
IF Y$="" THEN GOTO GetInputLoop
IF ASC(Y$)=0 THEN Y$=CHR$(13)
IF ASC(Y$)=20 THEN GOTO GetInputDel
IF ASC(Y$)=13 AND LX=0 THEN PRINT "{CLR}": PRINT FCOL$ : RETURN
IF ASC(Y$)=13 THEN PRINT : PRINT FCOL$ : RETURN
IF ASC(Y$)=32 THEN GOTO GetInputAppend
IF ASC(Y$)<46 OR ASC(Y$)>90 THEN GOTO GetInputLoop
GetInputDel: IF ASC(Y$)=20 AND LEN(LII$)<1 THEN GOTO GetInputLoop
IF Y$=CHR$(20) THEN Y$="" : LII$=LEFT$(LII$,(LEN(LII$)-1))
GetInputAppend: IF LEN(LII$)<LX THEN PRINT Y$;
IF LEN(LII$)<LX THEN LII$=LII$+Y$
GOTO GetInputLoop
Pause: REM ** PAUSE WITHOUT CR**
IF CRSTART=1 THEN CR$="PRESS RETURN TO BEGIN"
IF CRSTART=0 THEN CR$="PRESS RETURN TO CONTINUE"
LX=0 : PRINT "{REVERSE ON}{LIGHTBLUE}":PRINT CR$:PRINT "{REVERSE OFF}{WHITE}" : GOSUB GetInput
CRSTART=0
RETURN
