    PRINT : PRINT "{CLR}{REVERSE ON}STATUS REPORT:{REVERSE OFF}";CHR$(13) : X$="" : IF KLINGON_COUNT>1 THEN X$="S"
    PRINT : PRINT " KLINGONS LEFT :";KLINGON_COUNT
