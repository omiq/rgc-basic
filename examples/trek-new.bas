#OPTION PETSCII
SCREENCODES ON : BACKGROUND 0
NewGame: REM ** SUPER STAR TREK
REM ** BY MIKE MAYFIELD 1974
REM ** MODIFIED BY DAVID AHL 1978
REM ** CONVERTED TO 40 COLUMNS
REM ** BY ELECTRON.GREG 2022-2023
REM ** MODIFIED BY CHRIS GARRETT 2025
REM ** ( FOR TUTORIAL USE )
REM ** SUPPORT ELECTRON.GREG
REM ** https://electrongreg.itch.io/
REM **
CLR: Z2$="" : ATAKFLAG=0 : SLSFLAG=0: N=RND(-1)
ES$="E  " : KS$="K  " : BS$="B  " : SS$="*  " : EM$="   "
REM ** COLOURS AT END OF LISTING **
GOSUB InitColours
PRINT CHR$(147);
PRINT HCOL$;"{YELLOW}   --S-U-P-E-R---S-T-A-R---T-R-E-K--"
PRINT "{WHITE}"
FOR N=1 TO 5 : PRINT : NEXT : PRINT BCOL$;
PRINT "                    ,------*-------,"
PRINT "    ,-------------,  '---  -------'"
PRINT "    '--------{109}{109}--'      / /"
PRINT "          ,---{109}{109}-------/ /--,"
PRINT "          '----------------'" : PRINT DCOL$
PRINT "    THE USS ENTERPRISE --- NCC-1701"
FOR N=1 TO 5 : PRINT FCOL$ : NEXT : CRSTART=1 : GOSUB Pause
X9=RND(-TI) : REM ** RANDOM SEED GENERATOR **
PRINT : PRINT "{CLR}           GENERATING GALAXY";
Z$="                         "
DIM G(8,8),C(9,2),K(3,3),N(3),Z(8,8),D(8)
T=INT(RND(1)*20+20)*100 : T0=T : T9=25+INT(RND(1)*10) : D0=0 : E=3000 : E0=E
P=10 : P0=P : S9=200 : S=0 : B9=2 : K9=0 : X$="" : X0$=" IS "
DEF FND(D)=SQR((K(I,1)-S1)^2+(K(I,2)-S2)^2)
DEF FNR(R)=INT(RND(R)*7.98+1.01)
REM INITIALIZE ENTERPRISES POSITION
Q1=FNR(1) : Q2=FNR(1) : S1=FNR(1) : S2=FNR(1)
FORI=1TO9 : C(I,1)=0 : C(I,2)=0 : NEXTI
C(3,1)=-1 : C(2,1)=-1 : C(4,1)=-1 : C(4,2)=-1 : C(5,2)=-1 : C(6,2)=-1
C(1,2)=1 : C(2,2)=1 : C(6,1)=1 : C(7,1)=1 : C(8,1)=1 : C(8,2)=1 : C(9,2)=1
FORI=1TO8 : D(I)=0 : NEXTI
A1$="NAVSRSLRSPHATORSHEDAMCOMXXXHLP"
REM SETUP WHAT EXISTS IN GALAXY . . .
REM K3= # KLINGONS  B3= # STARBASES  S3 = # STARS
FORI=1TO8 : PRINT "."; : FORJ=1TO8 : K3=0 : Z(I,J)=0 : R1=RND(1)
IFR1>.98THENK3=3 : K9=K9+3 : GOTO GalGenBase
IFR1>.95THENK3=2 : K9=K9+2 : GOTO GalGenBase
IFR1>.80THENK3=1 : K9=K9+1
GalGenBase: B3=0 : IFRND(1)>.96THENB3=1 : B9=B9+1
G(I,J)=K3*100+B3*10+FNR(1) : NEXTJ : NEXTI : IFK9>T9 THEN T9=K9+1
PRINT
GOSUB ShowKey : REM ** KEY TO SRS ICONS **
GOSUB ShowCommands : REM ** USE THESE COMMANDS LIST **
PRINT : GOSUB Pause : REM ** PAUSE **
IF B9<>0 THEN GOTO ShowOrders
IF G(Q1,Q2)<200 THEN G(Q1,Q2)=G(Q1,Q2)+120 : K9=K9+1
B9=1 : G(Q1,Q2)=G(Q1,Q2)+10 : Q1=FNR(1) : Q2=FNR(1)
ShowOrders: K7=K9 : IF B9<>1 THEN X$="S" : X0$=" ARE "
PRINT : PRINT "{CLR}{REVERSE ON}YOUR ORDERS ARE AS FOLLOWS:{REVERSE OFF}" : PRINT
PRINT "DESTROY THE ";K9;" KLINGON WARSHIPS BEFORE"
PRINT "STARDATE ";T0+T9;". THIS GIVES YOU ";T9;" DAYS."
PRINT "THERE";X0$;B9;" STARBASE";X$;" IN THE GALAXY"
PRINT "FOR RESUPPLYING & REPAIRING YOUR SHIP."
I=RND(1)
REM HERE ANY TIME NEW QUADRANT ENTERED
NewQuadrant: Z4=Q1 : Z5=Q2 : K3=0 : B3=0 : S3=0 : G5=0 : D4=.5*RND(1) : Z(Q1,Q2)=G(Q1,Q2)
IF Q1 < 1 OR Q1 >8 OR Q2<1 OR Q2>8 THEN GOTO PlaceObjects
GOSUB QuadrantName : PRINT : IF T0<>T THEN GOTO EnterQuadrant
PRINT "YOUR MISSION BEGINS WITH YOUR STARSHIP"
PRINT "IN THE QUADRANT, ";G2$;"."
SRSFLAG=1
PRINT : GOSUB Pause : REM ** PAUSE **
PRINT : GOTO ParseQuadrant
EnterQuadrant: IF ATAKFLAG=1 THEN GOSUB Pause : ATAKFLAG=0 : PRINT
SRSFLAG=1 : PRINT "ENTERING ";G2$;" QUADRANT..."
ParseQuadrant: K3=INT(G(Q1,Q2)*.01) : B3=INT(G(Q1,Q2)*.1)-10*K3
S3=G(Q1,Q2)-100*K3-10*B3
FORI=1TO3 : K(I,1)=0 : K(I,2)=0 : NEXTI
PlaceObjects: FORI=1TO3 : K(I,3)=0 : NEXTI : Q$=Z$+Z$+Z$+Z$+Z$+Z$+Z$+LEFT$(Z$,17)
REM POSITION ENTERPRISE IN QUADRANT, THEN PLACE "K3" KLINGONS, &
REM "B3" STARBASES, & "S3" STARS ELSEWHERE.
A$=ES$ : Z1=S1 : Z2=S2
GOSUB PlaceToken
IF K3 < 1 THEN GOTO PlaceBase
FOR I=1 TO K3 : GOSUB FindEmpty : A$=KS$ : Z1=R1 : Z2=R2
GOSUB PlaceToken : K(I,1)=R1 : K(I,2)=R2 : K(I,3)=S9*(0.5+RND(1)) : NEXTI
PlaceBase: IF B3 < 1 THEN GOTO PlaceStars
GOSUB FindEmpty : A$=BS$ : Z1=R1 : B4=R1 : Z2=R2 : B5=R2 : GOSUB PlaceToken
PlaceStars: FOR I=1 TO S3 : GOSUB FindEmpty : A$=SS$ : Z1=R1 : Z2=R2 : GOSUB PlaceToken : NEXTI
Srs: GOSUB ShortRangeScan
MainLoop: IF S+E > 10 THEN IF E>10 OR D(7)=0 THEN GOTO CommandPrompt
PRINT : PRINT "** FATAL ERROR **"
PRINT "YOUVE STRANDED YOUR SHIP IN SPACE."
PRINT "YOU HAVE INSUFFICIENT MANOEUVRING"
PRINT "ENERGY, & SHIELD CONTROL IS PRESENTLY"
PRINT "INCAPABLE OF CROSS-CIRCUITING TO"
PRINT "ENGINE ROOM!!"
PRINT : GOSUB Pause
GOTO GameOver
CommandPrompt: PRINT : SRSFLAG=0 : LX=3 : PRINT "{13}{REVERSE ON}{LIGHTBLUE}COMMAND:{REVERSE OFF}{WHITE} "; : GOSUB GetInput
A$=LII$ : Z2$=A$ : ATAKFLAG=0
IF A$="SLS" THEN SLSFLAG=1
IF A$="SLS" THEN PRINT : PRINT "{CLR}{REVERSE ON}SHORT & LONG RANGE SCAN...{REVERSE OFF}" : GOTO SrsEntry
IF A$<>"KEY" THEN GOTO ParseCommand
GOSUB ShowKey : REM KEY TO SRS ICONS
GOTO CommandPrompt
ParseCommand: COMFLAG=0 : IF A$="GAL" AND D(8)>=0 THEN A$="COM" : COMFLAG=1
IF D(8)<0 AND A$="GAL" THEN PRINT : PRINT "SHIPS COMPUTER DISABLED" : GOTO CommandPrompt
FOR I=1 TO 10 : IF LEFT$(A$,3)<>MID$(A1$,3*I-2,3) THEN GOTO UnknownCommand
IF I=1 THEN GOTO Nav
IF I=2 THEN GOTO Srs
IF I=3 THEN GOTO Lrs
IF I=4 THEN GOTO Phasers
IF I=5 THEN GOTO Torpedo
IF I=6 THEN GOTO Shields
IF I=7 THEN GOTO Damage
IF I=8 THEN GOTO Computer
IF I=9 THEN GOTO MissionEnd
UnknownCommand: NEXTI : GOSUB ShowCommands
GOTO MainLoop
REM COURSE CONTROL BEGINS HERE
Nav: GOSUB ShowDirections : REM ** DIRECTION HELPER **
PRINT : LX=5 : PRINT "COURSE (1-9) :  "; : GOSUB GetInput
C1=VAL(LII$) : IFC1=9THENC1=1
IF C1>=1 AND C1<9 THEN GOTO NavWarp
BACKGROUND 6: COLOR 1
PRINT : PRINT "LT. SULU REPORTS, INCORRECT COURSE"
PRINT "DATA, SIR!";: BACKGROUND 0: PRINT
GOTO MainLoop
NavWarp: X$="8" : IFD(1)<0THENX$="0.2"
SRSFLAG=1 : LX=5 : PRINT "WARP FACTOR (0-";X$;") :  "; : GOSUB GetInput
W1=VAL(LII$) : IF D(1)<0 AND W1>.2 THEN GOTO NavWarpDamaged
IF W1>0 AND W1<=8 THEN GOTO NavEnergyCheck
IF W1=0 THEN GOTO MainLoop
PRINT : BACKGROUND 6: COLOR 1:PRINT "CHIEF ENGINEER SCOTT REPORTS THE"
PRINT "ENGINES WONT TAKE WARP ";W1;"!";: BACKGROUND 0 : GOTO MainLoop
NavWarpDamaged: PRINT : PRINT "WARP ENGINES ARE DAMAGED."
PRINT "MAXIMUM SPEED = WARP 0.2" : GOTO MainLoop
NavEnergyCheck: N=INT(W1*8+.5) : IFE-N>=0THEN GOTO KlingonsMove
PRINT : BACKGROUND 6: COLOR 1:PRINT "ENGINEERING REPORTS INSUFFICIENT ENERGY";
PRINT "AVAILABLE FOR WARP ";W1;"!";: BACKGROUND 0
IF S < N-E OR D(7) < 0 THEN GOTO MainLoop
PRINT :BACKGROUND 6: COLOR 1: PRINT "DEFLECTOR CONTROL ROOM ACKNOWLEDGES"
S1$=STR$(S)
PRINT "SHIELD ENERGY DEPLOYED IS ";S1$;" UNITS.";: BACKGROUND 0
GOTO MainLoop
REM KLINGONS MOVE/FIRE ON MOVING STARSHIP . . .
KlingonsMove: FORI=1 TO K3 : IFK(I,3)=0THEN GOTO MoveRepair
A$=EM$ : Z1=K(I,1) : Z2=K(I,2) : GOSUB PlaceToken : GOSUB FindEmpty
K(I,1)=Z1 : K(I,2)=Z2 : A$=KS$ : GOSUB PlaceToken
MoveRepair: NEXTI : GOSUB KlingonsFire : D1=0 : D6=W1 : IF W1>=1 THEN D6=1
FORI=1TO8 : IFD(I)>=0THEN GOTO RepairDone
D(I)=D(I)+D6 : IFD(I)>-.1AND D(I)<0THEND(I)=-.1 : GOTO RepairDone
IFD(I)<0THEN GOTO RepairDone
IFD1<>1THEND1=1 : PRINT : PRINT "DAMAGE CONTROL REPORT :   "
R1=I : GOSUB DeviceName : PRINT G2$;" REPAIR COMPLETED"
RepairDone: NEXTI
IFRND(1)>.2THEN GOTO MoveShip
R1=FNR(1) : IFRND(1)>=.6THEN GOTO DamagePartRepair
D(R1)=D(R1)-(RND(1)*5+1) : PRINT : PRINT "DAMAGE CONTROL REPORTS:"
GOSUB DeviceName : PRINT G2$;" DAMAGED" : GOTO MoveShip
DamagePartRepair: D(R1)=D(R1)+RND(1)*3+1 : PRINT : PRINT "DAMAGE CONTROL REPORTS:"
GOSUB DeviceName : PRINT G2$;" PARTLY REPAIRED"
REM BEGIN MOVING STARSHIP
MoveShip: A$=EM$ : Z1=INT(S1) : Z2=INT(S2) : GOSUB PlaceToken
X1=C(C1,1)+(C(C1+1,1)-C(C1,1))*(C1-INT(C1)) : X=S1 : Y=S2
X2=C(C1,2)+(C(C1+1,2)-C(C1,2))*(C1-INT(C1)) : Q4=Q1 : Q5=Q2
FORI=1 TO N : S1=S1+X1 : S2=S2+X2 : IFS1<1 OR S1>=9OR S2<1 OR S2>=9THEN GOTO CrossQuadrant
S8=INT(S1)*24+INT(S2)*3-26 : IFMID$(Q$,S8,2)="  "THEN GOTO MoveDone
S1=INT(S1-X1) : S2=INT(S2-X2) : PRINT : PRINT "WARP ENGINES SHUT DOWN AT ";
PRINT "SECTOR ";S1;",";S2
PRINT "DUE TO BAD NAVIGATION"
SRSFLAG=1
GOTO MovePlace
MoveDone: NEXTI : S1=INT(S1) : S2=INT(S2)
MovePlace: A$=ES$ : Z1=INT(S1) : Z2=INT(S2) : GOSUB PlaceToken : GOSUB ManeuverEnergy : T8=1
IFW1<1THENT8=.1*INT(10*W1)
T=T+T8 : IFT>T0+T9THEN GOTO GameOver
REM SEE IF DOCKED, THEN GET COMMAND
GOTO Srs
REM EXCEEDED QUADRANT LIMITS
CrossQuadrant: X=8*Q1+X+N*X1 : Y=8*Q2+Y+N*X2 : Q1=INT(X/8) : Q2=INT(Y/8) : S1=INT(X-Q1*8)
S2=INT(Y-Q2*8) : IFS1=0THENQ1=Q1-1 : S1=8
IFS2=0THENQ2=Q2-1 : S2=8
X5=0 : IFQ1<1THENX5=1 : Q1=1 : S1=1
IFQ1>8THENX5=1 : Q1=8 : S1=8
IFQ2<1THENX5=1 : Q2=1 : S2=1
IFQ2>8THENX5=1 : Q2=8 : S2=8
IFX5=0THEN GOTO CrossDone
PRINT : BACKGROUND 6: COLOR 1: PRINT "LT. UHURA REPORTS MESSAGE FROM STARFLEET";
PRINT " COMMAND:{13}PERMISSION TO ATTEMPT CROSSING OF GALACTIC PERIMETER IS HEREBY{13}{RED}*DENIED*{WHITE}";
PRINT " - SHUT DOWN YOUR ENGINES.{13}{13} CHIEF ENGINEER SCOTT REPORTS WARP";
PRINT " ENGINES SHUT DOWN AT SECTOR ";S1;",";S2;" OF QUADRANT ";Q1;",";Q2;".";:
BACKGROUND 0: PRINT
SRSFLAG=1
PRINT : GOSUB Pause
IFT>T0+T9THEN GOTO GameOver
CrossDone: IF8*Q1+Q2=8*Q4+Q5THEN GOTO MovePlace
T=T+1 : GOSUB ManeuverEnergy : GOTO NewQuadrant
REM MANEUVER ENERGY S/R **
ManeuverEnergy: E=E-N-10 : IFE>=0THENRETURN
PRINT : PRINT "SHIELD CONTROL SUPPLIES ENERGY TO"
PRINT "COMPLETE THE MANOEUVRE."
S=S+E : E=0 : IFS<=0THENS=0
RETURN
LrsEntry: REM LONG RANGE SCAN CODE
Lrs: K1=0
IFD(3)<0THENPRINT : PRINT "LONG RANGE SENSORS ARE INOPERABLE"
IFD(3)<0THEN SLSFLAG=0 : GOTO MainLoop
PRINT : PRINT "{13}{LIGHTBLUE}LONG RANGE SCAN FOR QUADRANT{WHITE} ";Q1;",";Q2
PRINT : O1$=" ┌─────┬─────┬─────┐" : PRINT "{13}{GREEN}";O1$;
O2$=" ├─────┼─────┼─────┤":O3$=" {173}─────{177}─────{177}─────{189}" 
PRINT "         ";ECOL$;"#";DCOL$;"#";HCOL$;"#";FCOL$
FOR I=Q1-1 TO Q1+1 : N(1)=-1 : N(2)=-2 : N(3)=-3 : FOR J=Q2-1 TO Q2+1
IF I>0 AND I<9 AND J>0 AND J<9 THEN N(J-Q2+2)=G(I,J) : Z(I,J)=G(I,J)
NEXTJ : FORL=1TO3
IF K1=2 AND L=3 THEN PRINT "";
PRINT " {221}";
IF K1=2 AND L=2 THEN PRINT " "; : GOTO LrsCell
PRINT " ";
LrsCell: IFN(L)<0THEN PRINT "▒▒▒"; : GOTO LrsColDone
G1$=RIGHT$(STR$(N(L)+1000),3)
G2$=ECOL$+MID$(G1$,1,1) : PRINT G2$;
G2$=DCOL$+MID$(G1$,2,1) : PRINT G2$;
G2$=HCOL$+MID$(G1$,3,1) : PRINT G2$;FCOL$;
LrsColDone: NEXTL : PRINT " {221}"; : K1=K1+1
IF K1=1 THEN PRINT "        . . ."
IF K1=3 THEN PRINT "      .   .   ."
IF K1=5 THEN PRINT "    .           ."
K1=K1+1 : IF K1<6 THEN PRINT O2$;
IF K1=6 THEN PRINT O3$;
IF K1=2 THEN PRINT "       .  .  ."
IF K1=4 THEN PRINT "     .  {CYAN}BASES{GREEN}";
IF K1=4 THEN PRINT "  ."
IF K1=6 THEN PRINT "  {PINK}KLINGONS{WHITE}    {YELLOW}STARS{WHITE}"
NEXT I : K1=0 : IF SLSFLAG=1 THEN SLSFLAG=0
GOTO MainLoop
REM PHASER CONTROL CODE BEGINS HERE
Phasers: IF D(4)<0 THEN PRINT : PRINT "PHASERS INOPERATIVE" : GOTO MainLoop
IF K3>0 THEN GOTO PhasersFire
NoEnemy: PRINT : BACKGROUND 6: COLOR 1: PRINT "SCIENCE OFFICER SPOCK REPORTS SENSORS"
PRINT "SHOW NO ENEMY SHIPS IN THIS QUADRANT";:BACKGROUND 0: PRINT : GOTO MainLoop
PhasersFire: IFD(8)<0 THEN PRINT : PRINT "COMPUTER FAILURE HAMPERS ACCURACY"
PRINT : PRINT "PHASERS LOCKED ON TARGET!  "
PhasersEnergy: PRINT : PRINT "ENERGY AVAILABLE = ";E;" UNITS"
LX=5 : PRINT "NUMBER OF UNITS TO FIRE :  "; : GOSUB GetInput
X=VAL(LII$) : IF X<=0 THEN GOTO MainLoop
IF E-X<0 THEN GOTO PhasersEnergy
E=E-X : IFD(7)<0 THEN X=X*RND(1)
H1=INT(X/K3) : FOR I=1 TO 3 : IFK(I,3)<=0 THEN GOTO PhaserDone
H=INT((H1/FND(0))*(RND(1)+2)) : IF H>.15*K(I,3) THEN GOTO PhaserHit
PRINT : PRINT " SENSORS SHOW NO DAMAGE TO ENEMY"
PRINT " AT ";K(I,1);",";K(I,2)
GOTO PhaserDone
PhaserHit: K(I,3)=K(I,3)-H : PRINT
PRINT H;" UNIT HIT KLINGON AT ";K(I,1);",";K(I,2)
IF K(I,3)<=0 THEN PRINT " *** KLINGON DESTROYED ***" : GOTO KlingonDestroyed
PRINT " (SENSORS SHOW ";INT(K(I,3));" UNITS REMAINING)"
GOTO PhaserDone
KlingonDestroyed: K3=K3-1 : K9=K9-1 : Z1=K(I,1) : Z2=K(I,2) : A$=EM$ : GOSUB PlaceToken
K(I,3)=0 : G(Q1,Q2)=G(Q1,Q2)-100 : Z(Q1,Q2)=G(Q1,Q2) : IF K9<=0 THEN GOTO Victory
PhaserDone: NEXTI
IF K3>0 THEN PRINT : GOSUB Pause
GOSUB KlingonsFire : GOTO MainLoop
REM PHOTON TORPEDO CODE BEGINS HERE
Torpedo: IF P<=0 THEN PRINT : PRINT "ALL PHOTON TORPEDOES EXPENDED" : GOTO MainLoop
IF D(5)<0 THEN PRINT : PRINT "PHOTON TUBES ARE NOT OPERATIONAL" : GOTO MainLoop
TorpedoCourse: GOSUB ShowDirections : REM ** DIRECTION HELPER **
PRINT : LX=5 : PRINT "PHOTON TORPEDO COURSE (1-9) :  "; : GOSUB GetInput
C1=VAL(LII$) : IF C1=9 THEN C1=1
IF C1>=1 AND C1<9 THEN GOTO TorpedoFire
PRINT : BACKGROUND 6: COLOR 1: PRINT "ENSIGN CHEKOV REPORTS, INCORRECT"
PRINT "COURSE DATA, SIR!";:BACKGROUND 0: PRINT : GOTO MainLoop
GOTO MainLoop
TorpedoFire: X1=C(C1,1)+(C(C1+1,1)-C(C1,1))*(C1-INT(C1)) : E=E-2 : P=P-1
X2=C(C1,2)+(C(C1+1,2)-C(C1,2))*(C1-INT(C1)) : X=S1 : Y=S2
PRINT : PRINT "TORPEDO TRACKING:"
TorpedoTrack: X=X+X1 : Y=Y+X2 : X3=INT(X+.5) : Y3=INT(Y+.5)
IF X3<1 OR X3>8 OR Y3<1 OR Y3>8 THEN GOTO TorpedoMiss
PRINT " ";X3;",";Y3 : A$=EM$ : Z1=X : Z2=Y : GOSUB CheckSector
IF Z3<>0 THEN GOTO TorpedoTrack
A$=KS$ : Z1=X : Z2=Y : GOSUB CheckSector : IF Z3=0 THEN GOTO TorpedoStar
PRINT " *** KLINGON DESTROYED ***"
K3=K3-1 : IF K3>0 THEN PRINT : GOSUB Pause
K9=K9-1 : IFK9<=0 THEN GOTO Victory
FOR I=1 TO 3 : IF X3=K(I,1) AND Y3=K(I,2) THEN GOTO TorpedoKlingonKill
NEXT I : I=3
TorpedoKlingonKill: K(I,3)=0 : GOTO TorpedoEnd
TorpedoStar: A$=SS$ : Z1=X : Z2=Y : GOSUB CheckSector : IF Z3=0 THEN GOTO TorpedoBase
PRINT " ** STAR AT";X3;",";Y3;"ABSORBED TORPEDO **"
IF K3<>0 THEN PRINT : GOSUB Pause
GOSUB KlingonsFire : GOTO MainLoop
TorpedoBase: A$=BS$ : Z1=X : Z2=Y : GOSUB CheckSector : IF Z3=0 THEN GOTO TorpedoCourse
PRINT " *** STARBASE DESTROYED ***"
PRINT : GOSUB Pause
B3=B3-1 : B9=B9-1
IF B9>0 OR K9>T-T0-T9 THEN GOTO CourtMartial
PRINT : BACKGROUND 6: COLOR 1: PRINT "THAT DOES IT, CAPTAIN!!  YOU ARE HEREBY"
PRINT "RELIEVED OF COMMAND AND SENTENCED TO 99"
PRINT "STARDATES AT HARD LABOUR ON CYGNUS 12!!";:BACKGROUND 0
GOTO MissionEnd
CourtMartial: PRINT : PRINT "STARFLEET COMMAND REVIEWING YOUR RECORD"
PRINT "TO CONSIDER COURT MARTIAL!" : D0=0
TorpedoEnd: Z1=X : Z2=Y : A$=EM$ : GOSUB PlaceToken
G(Q1,Q2)=K3*100+B3*10+S3 : Z(Q1,Q2)=G(Q1,Q2) : GOSUB KlingonsFire : GOTO MainLoop
TorpedoMiss: PRINT " ** TORPEDO MISSED **"
IF K3<>0 THEN PRINT : GOSUB Pause
GOSUB KlingonsFire : GOTO MainLoop
REM SHIELD CONTROL
Shields: IF D(7)<0 THEN PRINT : PRINT "SHIELD CONTROL INOPERABLE" : GOTO MainLoop
PRINT : PRINT "ENERGY AVAILABLE = ";E+S
LX=5 : PRINT "NUMBER OF UNITS TO SHIELDS :  "; : GOSUB GetInput
X=VAL(LII$)
IF X<0 OR S=X THEN PRINT "<SHIELDS UNCHANGED>" : GOTO MainLoop
IF X<=E+S THEN GOTO ShieldsSet
PRINT :  BACKGROUND 6: COLOR 1: PRINT "SHIELD CONTROL REPORTS THIS IS NOT THE"
PRINT "FEDERATION TREASURY."
PRINT "<SHIELDS UNCHANGED>";:BACKGROUND 0: PRINT : GOTO MainLoop
ShieldsSet: E=E+S-X : S=X : PRINT :BACKGROUND 6: COLOR 1: PRINT "DEFLECTOR CONTROL ROOM REPORT:"
PRINT "SHIELDS NOW AT ";INT(S);" UNITS PER"
PRINT "YOUR COMMAND.";:BACKGROUND 0: PRINT : GOTO MainLoop
REM DAMAGE CONTROL
Damage: IF D(6)>=0 THEN GOTO DamageReport
PRINT : PRINT "DAMAGE CONTROL REPORT NOT AVAILABLE"
IF D0=0 THEN GOTO MainLoop
DamageRepair: D3=0 : FOR I=1 TO 8 : IF D(I)<0 THEN D3=D3+.1
NEXT I : IF D3=0 THEN GOTO MainLoop
D3=D3+D4 : IF D3>=1 THEN D3=.9
PRINT : PRINT "TECHNICIANS STANDING BY TO EFFECT"
PRINT "REPAIRS TO YOUR SHIP;"
PRINT "ESTIMATED TIME TO REPAIR: "
PRINT .01*INT(100*D3);" STARDATES"
LX=1 : PRINT : PRINT "AUTHORISE THE REPAIR ORDER (Y/N)? "; : GOSUB GetInput
A$=LII$
IF A$<>"Y" THEN GOTO MainLoop
FOR I=1 TO 8 : IF D(I)<0 THEN D(I)=0
NEXT I : T=T+D3+.1
DamageReport: PRINT : PRINT " SYSTEM              STATE OF REPAIR"
PRINT      " ------------------- -----------------"
FOR R1=1 TO 8
GOSUB DeviceName : PRINT " ";G2$;LEFT$(Z$,20-LEN(G2$));
D2=INT(D(R1)*100)*.01
IF D2<0 THEN PRINT CCOL$;"DAMAGED     ";D2;FCOL$
IF D2>0 THEN PRINT "OPERATIONAL ";D2
IF D2=0 THEN PRINT "OPERATIONAL ";D2
NEXTR1 : IFD0<>0THEN GOTO DamageRepair
GOTO MainLoop
REM KLINGONS SHOOTING
KlingonsFire: IF K3<=0 THEN RETURN
IF D0<>0 THEN PRINT : PRINT "STARBASE SHIELDS PROTECT THE ENTERPRISE"
IF D0<>0 THEN RETURN
FOR I=1 TO 3 : IF K(I,3)<=0 THEN GOTO KlingonFireDone
H=INT((K(I,3)/FND(1))*(2+RND(1))) : S=S-H : K(I,3)=K(I,3)/(3+RND(0))
PRINT : PRINT H;" UNIT HIT ENTERPRISE FROM ";K(I,1);",";K(I,2)
IF S<=0 THEN GOTO ShipDestroyed
PRINT " <SHIELDS DOWN TO ";S;" UNITS>" : IF H<20 THEN GOTO KlingonFireDone
IF RND(1)>.6 OR H/S<=.02 THEN GOTO KlingonFireDone
R1=FNR(1) : D(R1)=D(R1)-H/S-.5*RND(1) : GOSUB DeviceName
PRINT : BACKGROUND 6: COLOR 1: PRINT "DAMAGE CONTROL REPORTS :  "
PRINT G2$;" DAMAGED BY THE HIT";:BACKGROUND 0: PRINT
