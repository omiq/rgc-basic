IF Z4=2 THEN GOTO NameRigel
IF Z4=3 THEN GOTO NameProcyon
IF Z4=4 THEN GOTO NameVega
IF Z4=5 THEN GOTO NameCanopus
IF Z4=6 THEN GOTO NameAltair
IF Z4=7 THEN GOTO NameSagittarius
IF Z4=8 THEN GOTO NamePollux
