PRINT "\n KEY TO SHORT RANGE SCANNER ICONS:" 
PRINT
PRINT "  E  = EARTH FLEET STARSHIP"
PRINT "  B  = EARTH SPACESTATION"
PRINT "  *  = PLANET"
PRINT "  K  = GLONKIN BATTLE CRUISER"
