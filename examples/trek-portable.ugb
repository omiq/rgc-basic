device_name$ (1)="FTL DRIVE"
device_name$ (2)="SHORT RANGE SENSORS"
device_name$ (3)="LONG RANGE SENSORS"
device_name$ (4)="LASER TARGETING"
device_name$ (5)="WARHEADS"
device_name$ (6)="DAMAGE CONTROL"
device_name$ (7)="SHIELDS"
device_name$ (8)="SHIP COMPUTER"
RETURN
END PROC
PROCEDURE initcolours
acol$ ="" 
bcol$ ="" 
ccol$ ="" 
dcol$ ="" 
ecol$ ="" 
fcol$ ="" 
gcol$ ="" 
hcol$ ="" 
icol$ =""
RETURN
END PROC
REM ** PRINT mission orders **
REM ** ===== one-time game setup (new game / replanett) ===== **
REM ** ===== enter a quadrant: set it up, place objects, short scan ===== **
REM ** ===== command phase: power CHECK, prompt, dispatch one command ===== **
REM ** ===== course control (nav) ===== **
REM maneuver power s/r **
REM ** ===== long range scan ===== **
REM ** ===== phaser control ===== **
REM ** ===== warhead ===== **
REM ** ===== shield control ===== **
REM ** ===== damage control ===== **
REM ** ===== glonkins shoot back (sets shipdead IF shields fail) ===== **
REM ** ===== END-of-game states ===== **
REM ** ===== ship destroyed ===== **
REM ** ===== show mission END ===== **
REM ** ===== ask play again ===== **
REM ** ===== show victory ===== **
REM ** ===== short range scan & summary (sls chains into lrs) ===== **
REM ** ===== library computer ===== **
REM ** ===== computer galactic record ===== **
REM ** ===== computer galaxy map ===== **
REM ** ===== computer base nav ===== **
REM ** ===== computer status report ===== **
REM ** ===== computer nav calc glonkin ===== **
REM ** ===== computer calculator ===== **
REM from/TO = sector y,x; dist_div=1 (calculator) OR 10 (ship/base nav in-sector)
REM ** ===== SHARED message: no enemy in quadrant ===== **
REM find EMPTY place in quadrant (FOR things)
REM set sector (token_x, token_y) TO cell code in the quadrant grid
REM RETURN 1 IF sector (token_x, token_y) holds cell code, ELSE 0
REM region_only=1: constellation name only (galaxy map row); 0: add quadrant i..iv
REM PRINT caption$, READ up TO max_len chars; RETURN typed LINE (lii$ also set)
REM ** GET INPUT **
REM GET characters UNTIL RETURN is pressed
REM ** pause without cr**
REM ** KEY TO srs icons **
REM ** list of commands **
REM ** direction helper **
REM ** galaxy map roman numerals **
REM ** three-letter command codes -> cmd (1..10) FOR docommand select case **
REM ** colours FOR in-game **
